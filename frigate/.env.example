# Copie este arquivo pra ".env" e preencha os valores reais:
#     cp .env.example .env
#
# O .env NÃO vai pro git (está no .gitignore), então a senha fica protegida.

# Senha das câmeras RTSP (usada como {FRIGATE_RTSP_PASSWORD} no config.yml).
# Se cada câmera tiver uma senha diferente, você pode escrever a senha
# direto no go2rtc do config.yml, mas o ideal é padronizar.
FRIGATE_RTSP_PASSWORD=troque_pela_senha_da_camera

# Pasta onde o Frigate grava os vídeos.
# - Pra TESTAR a interface agora: pode deixar comentado (usa ./storage local).
# - Pra gravar no NAS de verdade: descomente e ponha o caminho real, ex.:
# FRIGATE_STORAGE=/mnt/nas/frigate

# (Opcional) Chave secreta pra sessão/JWT da interface. Se não definir,
# o Frigate gera uma automaticamente na primeira vez.
# FRIGATE_JWT_SECRET=
